# 服务端口（建议 3290，与其他服务不冲突）
PORT=3290
NODE_ENV=production
TZ=Asia/Shanghai

# 数据目录（SQLite 库与上传的报告文件）
DATA_DIR=./data

# 会话密钥（请替换为随机串：openssl rand -hex 32）
SESSION_SECRET=please_change_me_to_a_random_string

# Cookie 名称与有效期（小时）
COOKIE_NAME=ff_session
SESSION_TTL_HOURS=168

# 子路径部署前缀，例如 /fundFarm（留空则部署在根路径）
BASE_PATH=

# 可选：AI 报告解析（混元），不配置则退化为本地摘要
HUNYUAN_API_URL=https://tokenhub.tencentmaas.com/v1/chat/completions
HUNYUAN_API_KEY=
HUNYUAN_MODEL=hy3
HUNYUAN_TIMEOUT_MS=45000

# AI 解析限流
RATE_LIMIT_PARSE_PER_MINUTE=5
RATE_LIMIT_PARSE_PER_DAY=30
